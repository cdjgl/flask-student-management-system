# 复制本文件为 .env 并填写实际配置。.env 已被 .gitignore 排除，不会提交到仓库。

# ---- MySQL 数据库 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password-here
DB_NAME=student_management

# ---- 会话 ----
# 生产环境务必设置为固定随机长字符串，例如: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
SESSION_LIFETIME_HOURS=1

# ---- 首次启动自动创建的管理员 ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
